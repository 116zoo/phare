{
  "mcpServers": {
    "Dolibarr": {
      "command": "node",
      "args": ["/home/ropie/mcp-dolibarr/build/index.js"],
      "env": {
        "DOLIBARR_URL": "${DOLIBARR_URL}",
        "DOLIBARR_API_KEY": "${DOLIBARR_API_KEY}"
      }
    },
    "Payload": {
      "type": "http",
      "url": "http://127.0.0.1:3002/api/mcp",
      "headers": {
        "Authorization": "Bearer ${PAYLOAD_MCP_KEY}"
      }
    },
    "Payload (production)": {
      "type": "http",
      "url": "https://payload-website-starter-snowy-gamma.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${PAYLOAD_MCP_KEY}"
      }
    }
  }
}
